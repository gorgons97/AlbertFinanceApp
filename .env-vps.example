# ============================================================
# Albert — .env-vps di esempio (PRODUZIONE / VPS)
# ============================================================
# COME USARLO:
#   1. Copia questo file in ".env-vps" (stessa cartella):
#        cp .env-vps.example .env-vps
#   2. Sostituisci i valori con i TUOI (dominio reale, password forti).
#   3. Avvia la produzione:
#        docker compose --env-file .env-vps -f docker-compose.prod.yml up -d --build
#
# ATTENZIONE: .env-vps NON va mai committato nel repo (aggiungilo al .gitignore).
# Questo file è solo un modello.

# ------------------------------------------------------------
# POSTGRES_PASSWORD — password del database (OBBLIGATORIA)
# Deve essere forte e diversa da quella di sviluppo.
# Per generarne una:  openssl rand -base64 24
# ------------------------------------------------------------
POSTGRES_PASSWORD=Q7sT9wXz2KpLmNvB4RcD6FgH1

# ------------------------------------------------------------
# SECRET_KEY — chiave di firma dei token JWT (OBBLIGATORIA)
# Stringa lunga e casuale:  openssl rand -hex 32
# ------------------------------------------------------------
SECRET_KEY=4f8c2a1b9d3e7f0a5c6b8d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a

# ------------------------------------------------------------
# CORS_ORIGINS — origini autorizzate a chiamare il backend
# In produzione metti SOLO il tuo dominio HTTPS.
# ------------------------------------------------------------
CORS_ORIGINS=https://albert.tuodominio.it

# ------------------------------------------------------------
# REACT_APP_API_BASE — LASCIA VUOTA
# Le chiamate del frontend hanno già il prefisso "/api": in HTTPS diventano
# same-origin e nginx le inoltra al backend. NON mettere "/api" qui
# (raddoppierebbe il prefisso).
# ------------------------------------------------------------
REACT_APP_API_BASE=

# ------------------------------------------------------------
# SUPABASE / GOTRUE - AUTENTICAZIONE E GOOGLE OAUTH
# ------------------------------------------------------------
# Site URL e API URL per i redirect e i link email
GOTRUE_SITE_URL=https://TUODOMINIO.it
API_EXTERNAL_URL=https://TUODOMINIO.it

# Credenziali Google OAuth (Lascia disabilitato se non serve)
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=TUO_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TUO_GOOGLE_CLIENT_SECRET
# L'URI da registrare su Google Cloud Console deve essere esattamente:
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=https://TUODOMINIO.it/auth/v1/callback

# Configurazione SMTP per recupero password (es. Brevo, SendGrid, Gmail)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tuamail@example.com
SMTP_PASS=tuapasswordsmtp
# IMPORTANTE: SMTP_ADMIN_EMAIL DEVE essere l'indirizzo email mittente AUTORIZZATO e verificato sul tuo provider SMTP
SMTP_ADMIN_EMAIL=tuamail@example.com
