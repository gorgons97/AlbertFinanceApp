# ============================================================
# Albert — file .env di esempio
# ============================================================
# COME USARLO:
#   1. Copia questo file in ".env" (nella stessa cartella):
#        cp .env.example .env
#   2. Sostituisci i valori segnaposto con i tuoi.
#   3. Riavvia i container per applicare le variabili:
#        docker compose up -d
#
# ATTENZIONE: .env NON va mai committato nel repo (è già in .gitignore).
# Questo file .env.example è solo un modello e può restare nel repo.

# ------------------------------------------------------------
# SECRET_KEY — chiave di firma dei token JWT
# OBBLIGATORIA in produzione: DEVE essere una stringa lunga e casuale.
# Per generarne una nuova:
#     openssl rand -hex 32
# Esempio di valore (sostituiscilo con uno tuo!):
# ------------------------------------------------------------
SECRET_KEY=f7453af99b8ae1d32eb011576940ccc678d078fa073a0ed9c21830734b0f49ac

# ------------------------------------------------------------
# CORS_ORIGINS — origini autorizzate a chiamare il backend
# Separa più origini con la virgola, SENZA spazi.
# In produzione metti SOLO il tuo dominio (https).
# Se lasci vuoto, il backend accetta TUTTE le origini (solo sviluppo!).
# ------------------------------------------------------------
CORS_ORIGINS=https://albert.tuodominio.it

# ------------------------------------------------------------
# REACT_APP_API_BASE — URL dell'API visto dal frontend
# LASCIA VUOTA: le chiamate del codice hanno già il prefisso "/api".
# - pagina HTTPS (dietro nginx) -> stessa origine "/api" (nginx inoltra al backend)
# - pagina HTTP (sviluppo)      -> http://<host>:8001
# NON mettere "/api" qui: raddoppierebbe il prefisso.
# ------------------------------------------------------------
REACT_APP_API_BASE=
